#!/bin/sh
# RepoYeti pre-commit gate: web i18n compliance + Biome lint + tsc typecheck (no full build).
# Enable once with:  git config core.hooksPath .githooks
# Bypass a single commit with:  git commit --no-verify
if [ -f web/scripts/i18n-check.mjs ] && [ -d web/node_modules ]; then
  echo "› i18n-check…"
  if ! (cd web && node scripts/i18n-check.mjs); then
    echo "✗ i18n-check failed — fix the above, or 'git commit --no-verify' to bypass." >&2
    exit 1
  fi
fi

# Lint + typecheck mirror CI's `bun run check` / `typecheck`, caught locally before the push.
# Both are skipped gracefully if bun isn't on PATH (e.g. a non-dev environment).
if command -v bun >/dev/null 2>&1; then
  # Tracked-imports first: it is the only gate below that looks at the INDEX rather than the working
  # tree, so it is the only one that can see an import pointing at a file you never `git add`ed —
  # the exact state that put an unbuildable main in front of every source self-update (issue #24).
  # It is also the cheapest (no compile), so a commit that is going to be rejected is rejected fast.
  echo "› tracked-imports…"
  if ! bun run check:imports; then
    echo "✗ an import points at an untracked file — 'git add' it, or 'git commit --no-verify' to bypass." >&2
    exit 1
  fi
  echo "› lint…"
  if ! bun run lint; then
    echo "✗ biome lint failed — fix the above, or 'git commit --no-verify' to bypass." >&2
    exit 1
  fi
  echo "› typecheck…"
  if ! bun run typecheck; then
    echo "✗ tsc typecheck failed — fix the above, or 'git commit --no-verify' to bypass." >&2
    exit 1
  fi
  # The root typecheck is tsc over the daemon and never looks at web/. A Vue template reading a
  # store field that does not exist passed this gate cleanly and failed CI an hour later, so the
  # web half runs here too. vue-tsc -b is incremental; the repeat cost is a second or two.
  if [ -d web/node_modules ]; then
    echo "› web typecheck…"
    if ! (cd web && bun run typecheck); then
      echo "✗ vue-tsc typecheck failed — fix the above, or 'git commit --no-verify' to bypass." >&2
      exit 1
    fi
  fi
fi

# Kit-sync guard: a kit-synced file edited in this app instead of the kit forks it from every
# other app. Only staged files are considered, and a copy that MATCHES the kit (a re-sync) passes.
if command -v node >/dev/null 2>&1; then
  echo "› kit-sync guard…"
  node .githooks/check-kit-sync-staged.mjs repoyeti || exit 1
fi
